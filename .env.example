# Option A — preferred for Vercel: paste the JWT from POST /auth/authenticate
WORLDCUP_API_TOKEN=

# Option B — app will auto-authenticate on each cold start (slightly slower)
WORLDCUP_API_EMAIL=
WORLDCUP_API_PASSWORD=

# Optional: override API base (defaults to https://worldcup26.ir)
# WORLDCUP_API_BASE_URL=https://worldcup26.ir
